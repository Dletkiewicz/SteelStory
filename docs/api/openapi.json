{
  "openapi": "3.1.0",
  "info": {
    "title": "Steelstory API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Register an account without logging in",
        "description": "Requires the CSRF token and its session cookie. Body limited to 4096 bytes.",
        "operationId": "registerAccount",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "description": "Token from getCsrfToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access denied or missing/invalid CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "409": {
            "description": "Canonical email already registered",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 4096 bytes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Invalidate the session",
        "description": "Requires CSRF, including for an anonymous session. Fetch a fresh token before the next mutation.",
        "operationId": "logout",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "description": "Token from getCsrfToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session invalidated"
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access denied or missing/invalid CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 4096 bytes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Authenticate and rotate the session ID",
        "description": "Requires CSRF and its session cookie. Fetch a fresh CSRF token after success. Body limit 4096 bytes. Missing/empty passwords, invalid Unicode, more than 128 code points or invalid emails return 400 before account lookup. Valid input with incorrect credentials, an unknown email or a disabled account returns the same 401 response.",
        "operationId": "login",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "description": "Token from getCsrfToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authenticated account; rotated SESSION cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access denied or missing/invalid CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 4096 bytes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "status-controller"
        ],
        "summary": "Check API connectivity",
        "description": "Public connectivity endpoint. Database readiness is reported by Actuator health.",
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Get the active account identified by the session",
        "operationId": "getCurrentAccount",
        "responses": {
          "200": {
            "description": "Current account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access denied or missing/invalid CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Obtain a CSRF token bound to the session",
        "description": "Retain the SESSION cookie and send token in X-CSRF-TOKEN. Repeat after login/logout. Do not cache.",
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "description": "CSRF header name and token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access denied or missing/invalid CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CredentialsRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "ASCII email; surrounding whitespace stripped, canonical lowercase; max 254 after normalization.",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "description": "15–128 Unicode code points, preserved exactly; no trimming or normalization.",
            "maxLength": 128,
            "minLength": 15,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "IdentityProblemResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "detail",
          "instance",
          "status",
          "title",
          "type"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "createdAt",
          "email",
          "id",
          "status",
          "updatedAt"
        ]
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "application": {
            "type": "string",
            "enum": [
              "steelstory"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "UP"
            ]
          }
        },
        "required": [
          "application",
          "status"
        ]
      },
      "CsrfResponse": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string",
            "enum": [
              "X-CSRF-TOKEN"
            ]
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "headerName",
          "token"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "ASCII email; surrounding whitespace stripped, canonical lowercase; max 254 after normalization.",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "description": "1–128 Unicode code points, preserved exactly; no trimming or normalization. The minimum length for new passwords does not apply to login.",
            "maxLength": 128,
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "description": "HttpOnly session cookie. Obtain CSRF separately before unsafe requests.",
        "name": "SESSION",
        "in": "cookie"
      }
    }
  }
}
